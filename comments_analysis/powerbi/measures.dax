// =====================================================================================
// Workload Comments Analysis - DAX measures
// Create an empty table "_Measures" (Enter data > one blank column, then hide the column)
// and add each measure below to it. Display folders are suggested in [brackets].
// Scenario names: "Planning Input", "Discipline Comment", "After Implementation".
// =====================================================================================

// [1 Workload]
Total MH = SUM ( FactWorkload[MH] )
Planning MH = CALCULATE ( [Total MH], DimScenario[Scenario] = "Planning Input" )
Discipline MH = CALCULATE ( [Total MH], DimScenario[Scenario] = "Discipline Comment" )
Implemented MH = CALCULATE ( [Total MH], DimScenario[Scenario] = "After Implementation" )

// Man-months use the same 150 MH factor as the existing workload report
Planning MM = DIVIDE ( [Planning MH], 150 )
Discipline MM = DIVIDE ( [Discipline MH], 150 )
Implemented MM = DIVIDE ( [Implemented MH], 150 )

// [2 Deviation]
Disc vs Plan MH = [Discipline MH] - [Planning MH]
Impl vs Plan MH = [Implemented MH] - [Planning MH]
Impl vs Disc MH = [Implemented MH] - [Discipline MH]
Disc vs Plan % = DIVIDE ( [Disc vs Plan MH], [Planning MH] )
Impl vs Disc % = DIVIDE ( [Impl vs Disc MH], [Discipline MH] )
// same name and meaning as the existing PBIX measure, now against the planning input
ABS_Variance = ABS ( [Disc vs Plan MH] )
ABS_Variance_MMonth = DIVIDE ( [ABS_Variance], 150 )

// [3 Comment items]
Gross Increase MH = SUM ( FactCommentItems[Gross Increase] )
Gross Reduction MH = SUM ( FactCommentItems[Gross Reduction] )
Net Change MH = [Gross Increase MH] + [Gross Reduction MH]
Requested Change MH = [Gross Increase MH] - [Gross Reduction MH]
Concern Items = CALCULATE ( COUNTROWS ( FactCommentItems ), FactCommentItems[Concern] = "Yes" )
Projects with Concern = CALCULATE ( DISTINCTCOUNT ( FactCommentItems[ProjectCode] ), FactCommentItems[Concern] = "Yes" )
Departments With Concern = CALCULATE ( DISTINCTCOUNT ( FactCommentItems[DeptCode] ), FactCommentItems[Concern] = "Yes" )
New Project Rows =
    CALCULATE (
        COUNTROWS ( FactCommentItems ),
        KEEPFILTERS ( CONTAINSSTRING ( FactCommentItems[Primary Type], "New" ) )
    )
New Project MH =
    CALCULATE (
        SUM ( FactCommentItems[Item Discipline MH] ),
        KEEPFILTERS ( CONTAINSSTRING ( FactCommentItems[Primary Type], "New" ) )
    )
Phase Moves = CALCULATE ( COUNTROWS ( FactCommentItems ), FactCommentItems[Requested Phase] <> "" )
Unresolved Blank MH = SUM ( FactCommentItems[Blank Not Applied MH] )
Changed Cells = CALCULATE ( COUNTROWS ( FactCellChanges ), FactCellChanges[Cell Status] <> "Blank retained" )

// [4 Implementation]
Implemented of Request MH = SUM ( FactCommentItems[Implemented Request MH] )
Implementation Rate = DIVIDE ( [Implemented of Request MH], [Requested Change MH] )
Items Implemented = CALCULATE ( [Concern Items], FactCommentItems[Implementation Status] = "Implemented" )
Items Partially Implemented = CALCULATE ( [Concern Items], FactCommentItems[Implementation Status] = "Partially implemented" )
Items Not Implemented =
    CALCULATE ( [Concern Items], LEFT ( FactCommentItems[Implementation Status], 15 ) = "Not implemented" )
Planner Change Without Comment MH = SUM ( FactCommentItems[Unrequested Change MH] )

// [5 Capacity] - capacity is per month, so multiply by the months in context
Months In Context = COUNTROWS ( VALUES ( DimDate[Month] ) )
Capacity MH = SUM ( DimDepartment[Capacity_MH_per_Month] ) * [Months In Context]
Effective Heads = SUM ( DimDepartment[Effective_Heads] )
Utilisation Planning = DIVIDE ( [Planning MH], [Capacity MH] )
Utilisation Discipline = DIVIDE ( [Discipline MH], [Capacity MH] )
Utilisation Implemented = DIVIDE ( [Implemented MH], [Capacity MH] )
Firm Discipline MH = CALCULATE ( [Discipline MH], DimCategory[Firm Workload] = "Yes" )
Firm Utilisation Discipline = DIVIDE ( [Firm Discipline MH], [Capacity MH] )
Overload Months (Discipline) =
    COUNTROWS ( FILTER ( VALUES ( DimDate[Month] ), [Utilisation Discipline] > 1 ) )
Extra Heads Needed (Peak) =
    VAR PeakMH = MAXX ( VALUES ( DimDate[Month] ), [Discipline MH] )
    VAR CapPerMonth = SUM ( DimDepartment[Capacity_MH_per_Month] )
    RETURN MAX ( 0, DIVIDE ( PeakMH - CapPerMonth, 150 ) )

// [6 Severity]
Critical Projects = CALCULATE ( [Projects with Concern], DimProject[Severity] = "Critical" )
High Projects = CALCULATE ( [Projects with Concern], DimProject[Severity] = "High" )

// [7 Labels and formatting helpers]
Selected Department =
    IF ( HASONEVALUE ( DimDepartment[DeptCode] ), SELECTEDVALUE ( DimDepartment[Dept Label] ), "All departments" )
As Of Label = "Cycle " & SELECTEDVALUE ( DimCycle[Cycle], "(select one cycle)" )
// Use with Format > Conditional formatting > Field value on deviation visuals
Deviation Colour =
    SWITCH ( TRUE (), [Disc vs Plan MH] > 0, "#EB6834", [Disc vs Plan MH] < 0, "#2A78D6", "#9E9E9E" )
Severity Colour =
    SWITCH ( SELECTEDVALUE ( DimProject[Severity] ),
        "Critical", "#C00000", "High", "#F4B183", "Medium", "#FFE699", "Low", "#E2EFDA", "#F2F2F2" )
Implementation Colour =
    SWITCH ( TRUE (), ISBLANK ( [Implementation Rate] ), "#F2F2F2",
        [Implementation Rate] >= 0.95, "#C6EFCE", [Implementation Rate] >= 0.05, "#FFEB9C", "#FFC7CE" )

// [8 Legacy workload %] - same definitions as the existing Forecast Comments PBIX, one set per scenario.
// Run+Loan = Running + Loan To; Internal = Internal / Unforeseen; WL% = all categories; Projects Total% = firm.
Run+Loan MH (Planning) = CALCULATE ( [Planning MH], DimCategory[Category] IN { "Running", "Loan To" } )
Run+Loan MH (Discipline) = CALCULATE ( [Discipline MH], DimCategory[Category] IN { "Running", "Loan To" } )
Run+Loan MH (Implemented) = CALCULATE ( [Implemented MH], DimCategory[Category] IN { "Running", "Loan To" } )
Running+Loan% (Planning) = DIVIDE ( [Run+Loan MH (Planning)], [Capacity MH] )
Running+Loan% (Discipline) = DIVIDE ( [Run+Loan MH (Discipline)], [Capacity MH] )
Running+Loan% (Implemented) = DIVIDE ( [Run+Loan MH (Implemented)], [Capacity MH] )
Internal% (Planning) = DIVIDE ( CALCULATE ( [Planning MH], DimCategory[Category] = "Internal / Unforeseen" ), [Capacity MH] )
Internal% (Discipline) = DIVIDE ( CALCULATE ( [Discipline MH], DimCategory[Category] = "Internal / Unforeseen" ), [Capacity MH] )
Internal% (Implemented) = DIVIDE ( CALCULATE ( [Implemented MH], DimCategory[Category] = "Internal / Unforeseen" ), [Capacity MH] )
Signature% (Planning) = DIVIDE ( CALCULATE ( [Planning MH], DimCategory[Category] = "Under Signature" ), [Capacity MH] )
Signature% (Discipline) = DIVIDE ( CALCULATE ( [Discipline MH], DimCategory[Category] = "Under Signature" ), [Capacity MH] )
Signature% (Implemented) = DIVIDE ( CALCULATE ( [Implemented MH], DimCategory[Category] = "Under Signature" ), [Capacity MH] )
Proposal% (Planning) = DIVIDE ( CALCULATE ( [Planning MH], DimCategory[Category] = "Proposal" ), [Capacity MH] )
Proposal% (Discipline) = DIVIDE ( CALCULATE ( [Discipline MH], DimCategory[Category] = "Proposal" ), [Capacity MH] )
Proposal% (Implemented) = DIVIDE ( CALCULATE ( [Implemented MH], DimCategory[Category] = "Proposal" ), [Capacity MH] )
Potential% (Planning) = DIVIDE ( CALCULATE ( [Planning MH], DimCategory[Category] = "Potential Opportunity" ), [Capacity MH] )
Potential% (Discipline) = DIVIDE ( CALCULATE ( [Discipline MH], DimCategory[Category] = "Potential Opportunity" ), [Capacity MH] )
Potential% (Implemented) = DIVIDE ( CALCULATE ( [Implemented MH], DimCategory[Category] = "Potential Opportunity" ), [Capacity MH] )
Case1% (Planning) = [Running+Loan% (Planning)] + [Internal% (Planning)]
Case1% (Discipline) = [Running+Loan% (Discipline)] + [Internal% (Discipline)]
Case1% (Implemented) = [Running+Loan% (Implemented)] + [Internal% (Implemented)]
Projects Total% (Planning) = [Case1% (Planning)] + [Signature% (Planning)]
Projects Total% (Discipline) = [Case1% (Discipline)] + [Signature% (Discipline)]
Projects Total% (Implemented) = [Case1% (Implemented)] + [Signature% (Implemented)]
WL% (Planning) = [Projects Total% (Planning)] + [Proposal% (Planning)] + [Potential% (Planning)]
WL% (Discipline) = [Projects Total% (Discipline)] + [Proposal% (Discipline)] + [Potential% (Discipline)]
WL% (Implemented) = [Projects Total% (Implemented)] + [Proposal% (Implemented)] + [Potential% (Implemented)]

// [9 Bridge and coverage]
New Work MH = SUM ( FactCommentItems[Bridge New Work MH] )
Increase Within Schedule MH = SUM ( FactCommentItems[Bridge Increase MH] )
Extension or Earlier Start MH = SUM ( FactCommentItems[Bridge Extension MH] )
Reduction Within Schedule MH = SUM ( FactCommentItems[Bridge Reduction MH] )
Removed Allocation MH = SUM ( FactCommentItems[Bridge Removed MH] )
Bridge Check MH =
    [New Work MH] + [Increase Within Schedule MH] + [Extension or Earlier Start MH] + [Reduction Within Schedule MH]
        + [Removed Allocation MH]
        - [Net Change MH]
Possible Transfer MH = SUM ( PossibleTransfers[Possible Offset MH] )
Processed Planning MH = CALCULATE ( [Planning MH], DimDepartment[Feedback Processed] = "Yes" )
Feedback Coverage % = DIVIDE ( [Processed Planning MH], [Planning MH] )
Departments Processed = CALCULATE ( DISTINCTCOUNT ( DimDepartment[DeptCode] ), DimDepartment[Feedback Processed] = "Yes" )
Capacity Line = IF ( ISBLANK ( [Capacity MH] ), BLANK (), 1 )
